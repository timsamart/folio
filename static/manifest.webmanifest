{
  "id": "./",
  "name": "Folio — Markdown Reader",
  "short_name": "Folio",
  "description": "A quiet home for your Markdown. Read code, diagrams and mathematics, even offline.",
  "start_url": "./index.html",
  "scope": "./",
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [{
        "name": "files",
        "accept": [".md", ".markdown", ".mdown", ".txt", "text/markdown", "text/x-markdown", "text/plain", "application/octet-stream"]
      }]
    }
  },
  "display": "standalone",
  "background_color": "#f4f6fa",
  "theme_color": "#f4f6fa",
  "icons": [
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ]
}
